# Writes ${OUT} (build_stamp.hpp) with the build time and the git hash of ${SRC}.
# Run at every build (see the build_info target); the file is replaced only when its text changes.
string(TIMESTAMP now "%Y-%m-%d %H:%M")
execute_process(COMMAND git -C "${SRC}" rev-parse --short HEAD
  OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE status ERROR_QUIET)
if(NOT status EQUAL 0 OR hash STREQUAL "")
  set(hash "nogit")
endif()
set(text "#pragma once\n// Generated by cmake/build_info.cmake at every build. Do not edit.\nconstexpr const char* BOCCIA_BUILD_TIME = \"${now}\";\nconstexpr const char* BOCCIA_GIT_HASH = \"${hash}\";\n")
set(current "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" current)
endif()
if(NOT current STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
